<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="12dp"
    app:cardBackgroundColor="#1F2937"
    app:cardCornerRadius="24dp"
    app:cardElevation="10dp"
    app:strokeColor="#60A5FA"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- IMAGEM -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="230dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardPreventCornerOverlap="false">

            <ImageView
                android:id="@+id/item_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Foto do Item"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery" />
        </com.google.android.material.card.MaterialCardView>

        <!-- CONTEÚDO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="22dp">

            <!-- NOME -->
            <TextView
                android:id="@+id/item_nome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nome do Item Premium"
                android:textColor="#F9FAFB"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.03" />

            <!-- ENDEREÇO -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="6dp"
                    android:src="@android:drawable/ic_menu_mylocation"
                    android:tint="#60A5FA" />

                <TextView
                    android:id="@+id/item_endereco"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rua Principal, 123"
                    android:textColor="#60A5FA"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- DIVISOR -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="#374151" />

            <!-- DESCRIÇÃO -->
            <TextView
                android:id="@+id/item_descricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:lineSpacingExtra="5dp"
                android:maxLines="4"
                android:text="Esta é a descrição detalhada do item cadastrado pelo usuário. O layout foi modernizado para deixar a interface mais elegante, organizada e profissional."
                android:textColor="#D1D5DB"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>