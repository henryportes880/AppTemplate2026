<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111827"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        tools:context=".ui.dashboard.DashboardFragment">

        <TextView
            android:id="@+id/text_dashboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cadastro de Item"
            android:textColor="#F9FAFB"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/image_card"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginTop="28dp"
            app:cardBackgroundColor="#1F2937"
            app:cardCornerRadius="80dp"
            app:cardElevation="8dp"
            app:strokeColor="#60A5FA"
            app:strokeWidth="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_dashboard">

            <ImageView
                android:id="@+id/image_item"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Item Preview"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_camera"
                android:tint="#60A5FA" />
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/button_select_image"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Selecionar Imagem"
            android:textAllCaps="false"
            android:textColor="#93C5FD"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/image_card" />

        <EditText
            android:id="@+id/enderecoItemEditText"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#374151"
            android:hint="Endereço ou Localização"
            android:paddingStart="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#9CA3AF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/button_select_image" />

        <EditText
            android:id="@+id/nomeItemEditText"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#374151"
            android:hint="Nome do Item"
            android:inputType="text"
            android:paddingStart="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#9CA3AF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/enderecoItemEditText" />

        <EditText
            android:id="@+id/descricaoItemEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#374151"
            android:gravity="top"
            android:hint="Descrição detalhada"
            android:inputType="textMultiLine"
            android:minLines="4"
            android:padding="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#9CA3AF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nomeItemEditText" />

        <Button
            android:id="@+id/salvarItemButton"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#2563EB"
            android:text="Salvar Item"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/descricaoItemEditText" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>